<Window x:Class="TrustTunnel.Desktop.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тесты сервера" Width="560" Height="360" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Тесты сервера" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Ping и HTTPS проверка. Цели настраиваются в Настройках." Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <ListBox x:Name="ResultsList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,2,0,8" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Name}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Success}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Elapsed}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Скопировать" Click="CopyButton_Click" Style="{StaticResource GhostButton}" />
            <Button Content="Закрыть" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
