<Window x:Class="TrustTunnel.Desktop.TomlToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc Toml.Title}"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="TomlRevealCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Root"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Padding="10,7"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        Margin="0,0,8,0">
                                    <Path x:Name="CheckMark"
                                          Data="M4,9 L8,13 L15,5"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"
                                          Stretch="Uniform"
                                          Margin="3" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{local:Loc Toml.Title}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{local:Loc Toml.Subtitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <CheckBox x:Name="ShowSensitiveCheckBox"
                      Grid.Row="1"
                      Style="{StaticResource TomlRevealCheckBox}"
                      Content="{local:Loc Toml.ShowSensitive}"
                      ToolTip="{local:Loc Toml.ShowSensitiveTip}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10"
                      Checked="ShowSensitiveCheckBox_Toggled"
                      Unchecked="ShowSensitiveCheckBox_Toggled" />

            <Border Grid.Row="2"
                    Style="{StaticResource DialogFlatCard}"
                    Padding="8">
                <TextBox x:Name="TomlTextBox"
                         Style="{StaticResource DialogEditorTextBox}"
                         IsReadOnly="False" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="{local:Loc Toml.Copy}"
                        Click="CopyTomlButton_Click"
                        Style="{StaticResource GhostButton}" />
                <Button Content="{local:Loc Common.Save}"
                        Click="SaveButton_Click" />
                <Button Content="{local:Loc Common.Close}"
                        IsCancel="True"
                        Style="{StaticResource GhostButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
