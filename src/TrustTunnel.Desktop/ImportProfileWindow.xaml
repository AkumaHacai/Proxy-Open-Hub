<Window x:Class="TrustTunnel.Desktop.ImportProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc Import.Title}"
        Width="520"
        Height="330"
        MinWidth="520"
        MinHeight="330"
        MaxWidth="520"
        MaxHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource AppBackgroundBrush}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{local:Loc Import.Title}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{local:Loc Import.Subtitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="ClipboardStatusText"
                               Text="{local:Loc Import.CheckingClipboard}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ClipboardImportButton"
                                Content="{local:Loc Import.FromClipboard}"
                                Click="ClipboardImportButton_Click" />
                        <Button Content="{local:Loc Import.PasteLink}"
                                Click="PasteLinkButton_Click"
                                Style="{StaticResource GhostButton}" />
                        <Button Content="{local:Loc Import.Toml}"
                                Click="TomlButton_Click"
                                Style="{StaticResource GhostButton}" />
                        <Button Content="{local:Loc Import.Manual}"
                                Click="ManualButton_Click"
                                Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                    <TextBox x:Name="LinkTextBox"
                             Visibility="Collapsed"
                             MinHeight="76"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,14,0,0"
                    Padding="0,14,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="ResultText"
                               DockPanel.Dock="Left"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="{local:Loc Common.Cancel}"
                            IsCancel="True"
                            Style="{StaticResource GhostButton}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
