<Window x:Class="TrustTunnel.Desktop.ImportProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт профиля" Width="462" Height="258" MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Импорт профиля" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Если в буфере обмена есть tt:// ссылка, её можно импортировать сразу." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,45" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock x:Name="ClipboardStatusText" Text="Проверяю буфер обмена..." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ClipboardImportButton" Content="Импорт из буфера" Click="ClipboardImportButton_Click" />
                    <Button Content="Вставить ссылку" Click="PasteLinkButton_Click" Style="{StaticResource GhostButton}" />
                    <Button Content="TOML файл/текст" Click="TomlButton_Click" Style="{StaticResource GhostButton}" />
                    <Button Content="Вручную" Click="ManualButton_Click" Style="{StaticResource GhostButton}" />
                </WrapPanel>
                <TextBox x:Name="LinkTextBox" Visibility="Collapsed" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ResultText" DockPanel.Dock="Left" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right" Content="Отмена" IsCancel="True" Style="{StaticResource GhostButton}" />
        </DockPanel>
    </Grid>
</Window>
