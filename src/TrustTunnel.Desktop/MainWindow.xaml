                                                   Text="0.0"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="Mbps"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
