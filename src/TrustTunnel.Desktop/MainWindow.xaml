                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" ToolTip="{local:Loc Main.Settings}" Click="SettingsButton_Click">
                                    <Path Data="M4,7 H10 M14,7 H20 M12,5 V9 M4,12 H14 M18,12 H20 M16,10 V14 M4,17 H8 M12,17 H20 M10,15 V19"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform" />
