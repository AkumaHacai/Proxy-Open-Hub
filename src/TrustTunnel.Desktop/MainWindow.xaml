                                                       Text="{local:Loc Main.Connect}"
                                                       Margin="0,8,0,0"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
