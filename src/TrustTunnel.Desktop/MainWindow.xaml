                                                Margin="0,0,11,0">
                                            <TextBlock x:Name="CompactCountryText"
                                                       Text="TT"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    MinWidth="0"
