                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Width="24"
                                          Height="24"
                                          Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" ToolTip="{local:Loc Main.Logs}" Click="LogsButton_Click">
                                    <Path Data="M7,4 H17 L20,7 V20 H7 Z M17,4 V8 H20 M10,11 H17 M10,15 H17 M10,19 H14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
