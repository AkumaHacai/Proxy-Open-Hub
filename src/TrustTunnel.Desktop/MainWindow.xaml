<Window x:Class="TrustTunnel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Trust Client" Width="960" Height="620" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" SizeToContent="Manual" UseLayoutRounding="True"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="-1"
                            NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.15" />
        </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <Ellipse Width="7" Height="7"
                         Fill="{DynamicResource AccentBrush}"
                         Margin="0,0,6,0" />
                <TextBlock Text="Trust Client"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <Rectangle Grid.Column="1"
                       Fill="Transparent"
                       shell:WindowChrome.IsHitTestVisibleInChrome="False" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Width="40"
                        Height="36"
                        Style="{StaticResource TitleBarButton}"
                        ToolTip="Свернуть"
                        Click="MinimizeButton_Click">
                    <Path Data="M5,12 L19,12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>

                <Button x:Name="ExpandCollapseButton"
                        Width="40"
                        Height="36"
                        Style="{StaticResource TitleBarButton}"
                        ToolTip="Свернуть/развернуть панель"
                        Click="MaxRestoreButton_Click">
                    <Path x:Name="ExpandCollapsePath"
                          Data="M5,5 H19 V19 H5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Fill="Transparent"
                          Width="12"
                          Height="12"
                          Stretch="Uniform" />
                </Button>

                <Button x:Name="CloseButton"
                        Width="40"
                        Height="36"
                        Style="{StaticResource TitleBarCloseButton}"
                        ToolTip="Закрыть"
                        Click="CloseButton_Click">
                    <Path Data="M6,6 L18,18 M18,6 L6,18"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="12"
                          Height="12" />
                </Button>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="20,18,20,16" LastChildFill="False" Panel.ZIndex="2">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TrustTunnel" FontSize="28" FontWeight="Bold" />
                    <Border x:Name="HeaderStatusDot"
                            Width="10"
                            Height="10"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="5"
                            Margin="10,4,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            UseLayoutRounding="True"
                            ToolTip="Статус: Idle" />
                </StackPanel>
                <TextBlock Text="Alpha v0.1" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <WrapPanel x:Name="NavButtonsPanel"
                       DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Content="Профили маршрутов" Click="RoutingProfilesButton_Click" Style="{StaticResource GhostButton}" MinWidth="150" ToolTip="Открыть профили маршрутизации" />
                <Button Content="Редактировать TOML" Click="TomlToolsButton_Click" Style="{StaticResource GhostButton}" MinWidth="160" ToolTip="Открыть TOML текущего сервера" />
                <Button Content="Логи" Click="LogsButton_Click" Style="{StaticResource GhostButton}" MinWidth="86" ToolTip="Открыть окно логов" />
                <Button Content="Настройки" Click="SettingsButton_Click" Style="{StaticResource GhostButton}" MinWidth="116" ToolTip="Открыть настройки приложения" />
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="20,0,0,20" Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="300" MaxWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Серверы" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Выберите профиль или добавьте новый." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    </StackPanel>

                    <ListBox x:Name="ProfilesList"
                             Grid.Row="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="ProfilesList_SelectionChanged"
                             PreviewMouseRightButtonDown="ProfilesList_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="ProfilesContextMenu_Opened">
                                <MenuItem x:Name="ContextEditServerMenuItem" Header="Изменить" Click="ContextEditServer_Click" />
                                <MenuItem x:Name="ContextPingServerMenuItem" Header="Проверить соединение" Click="ContextPingServer_Click" />
                                <MenuItem x:Name="ContextDuplicateServerMenuItem" Header="Дублировать" Click="ContextDuplicateServer_Click" />
                                <MenuItem x:Name="ContextDeleteServerMenuItem" Header="Удалить" Click="ContextDeleteServer_Click" />
                                <Separator x:Name="ContextAddSeparator" />
                                <MenuItem x:Name="ContextImportClipboardMenuItem" Header="Добавить из буфера обмена" Click="ContextImportClipboard_Click" />
                                <MenuItem x:Name="ContextImportTomlMenuItem" Header="Добавить TOML" Click="ContextImportToml_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ServerListItem}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Stretch" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" MaxWidth="72" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,3,8,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap">
                                                <Run Text="{Binding Endpoint.UpstreamProtocol}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Listener.Mode}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Endpoint.Hostname}" />
                                            </TextBlock>
                                            <Border Margin="0,4,0,0"
                                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                                    CornerRadius="6"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    MaxWidth="176"
                                                    UseLayoutRounding="True"
                                                    Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TestResult.CountryCode, Converter={StaticResource CountryFlagConverter}}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TestResult.PingMs, StringFormat={}{0} ms}"
                                                               Foreground="{Binding TestResult.PingMs, Converter={StaticResource PingToBrushConverter}}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="↓" />
                                                        <Run Text="{Binding TestResult.DownloadMbps, Converter={StaticResource MbpsTextConverter}}" Foreground="{DynamicResource TextBrush}" />
                                                        <Run Text=" ↑" />
                                                        <Run Text="{Binding TestResult.UploadMbps, Converter={StaticResource MbpsTextConverter}}" Foreground="{DynamicResource TextBrush}" />
                                                        <Run Text=" Mbps" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button
                                                Click="ServerCardTestButton_Click"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Запустить тест скорости">
                                            <Path Data="M6,4 L18,12 L6,20 Z" Fill="{DynamicResource TextBrush}" Stretch="Uniform" Width="12" Height="12" />
                                        </Button>
                                        <Button
                                                Click="ServerCardRetestButton_Click"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Повторить тест"
                                                Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Path Data="M17,1 L21,5 L17,9 M3,11 A9,9 0 0 1 18,5 M7,23 L3,19 L7,15 M21,13 A9,9 0 0 1 6,19" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="DiagnosticsPanel"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DiagnosticsSummaryText" FontWeight="SemiBold" />
                            <ItemsControl x:Name="DiagnosticsResultsList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Status}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="12,8,12,12">
                        <Button x:Name="SidebarConnectButton"
                                Content="Подключиться"
                                Click="SidebarConnectButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,6"
                                Visibility="Collapsed"
                                ToolTip="Подключиться к выбранному серверу"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Button.RenderTransform>
                        </Button>
                        <Button Click="ImportButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0"
                                ToolTip="Добавить сервер">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,8,0" />
                                <TextBlock Text="Добавить сервер" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Button x:Name="CollapseButton"
                    Grid.Column="1"
                    Panel.ZIndex="99"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CollapseButtonStyle}"
                    ToolTip="Скрыть/Показать детали"
                    Click="CollapseButton_Click">
                <Path Data="M6,4 L10,8 L6,12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="12"
                      Height="12"
                      Fill="Transparent"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="CollapseArrowRotation" Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Button>

            <Grid x:Name="RightPanelContainer" Grid.Column="2" Margin="16,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border x:Name="ServerStatusIndicator"
                                    Width="52"
                                    Height="52"
                                    CornerRadius="26"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource StatusIndicator}"
                                    UseLayoutRounding="True">
                                <Grid>
                                    <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SelectedServerText" Text="Сервер не выбран" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Статус: Idle" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="ModeText" Text="TUN · HTTP/2 · Kill switch on" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,14,0,0">
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock x:Name="TransportPillText" Text="HTTP/2" />
                                </Border>
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock x:Name="ListenerPillText" Text="TUN" />
                                </Border>
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock x:Name="DnsPillText" Text="DNS default" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="ConnectButton" Content="Подключиться" Click="ConnectionActionButton_Click" Height="58" FontSize="16" MinWidth="160" />
                            <Button Content="Параметры" Click="ServerOptionsButton_Click" Style="{StaticResource GhostButton}" MinWidth="160" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Профиль маршрутизации" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Выбирается отдельно от сервера, как в обычных VPN-клиентах." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="RoutingProfileComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="RoutingProfileComboBox_SelectionChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
