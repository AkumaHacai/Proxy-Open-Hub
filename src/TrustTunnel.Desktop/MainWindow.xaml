                                    Style="{StaticResource RingButtonStyle}"
                                    Background="Transparent"
                                    Click="ConnectionActionButton_Click"
                                    ToolTip="{local:Loc Main.Connect}">
                                <Grid Width="204" Height="204" Background="Transparent">
                                    <Ellipse Width="192"
                                             Height="192"
                                             StrokeThickness="6"
                                             Stroke="{DynamicResource RingTrackBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Ellipse x:Name="RingProgress"
                                             Width="192"
                                             Height="192"
                                             StrokeThickness="6"
