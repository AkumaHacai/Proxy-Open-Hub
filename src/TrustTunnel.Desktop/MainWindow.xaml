                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{local:Loc Main.ServerParameters}"
                                    Margin="12,0,0,0"
                                    Click="ServerOptionsButton_Click">
                                <Path Data="M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 M10,9 V13 M10,6.8 V7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      Fill="Transparent" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
