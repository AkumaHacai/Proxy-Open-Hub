                                                   Text="{local:Loc Main.Disconnected}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border x:Name="DiagnosticsPanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="DiagnosticsSummaryText"
                                               FontWeight="Bold"
                                               FontSize="12" />
                                    <ItemsControl x:Name="DiagnosticsResultsList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                                        <Run Text="{Binding Name}" />
                                                        <Run Text=" - " />
                                                        <Run Text="{Binding Status}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SidebarConnectButton"
