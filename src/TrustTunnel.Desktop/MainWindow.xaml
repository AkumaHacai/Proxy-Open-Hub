<Window x:Class="TrustTunnel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Proxy Open Hub"
        Icon="Assets/proxy-open-hub.ico"
        Width="920"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="-1"
                            NonClientFrameEdges="None"
                            CornerRadius="26" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D94A43" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoreTabButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="122" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Height="3"
                                        CornerRadius="3"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Margin="0,-1,0,0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoreAddButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="CompactCoreSelectorButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoreMenuItemButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="MetricPanel" TargetType="Border" BasedOn="{StaticResource QuietPanel}">
            <Setter Property="Width" Value="116" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        </Style>

        <Style x:Key="ServerMetricChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="DetailPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="26"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center">
                    <Image Source="Assets/proxy-open-hub-32.png"
                           Width="22"
                           Height="22"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <Border x:Name="HeaderStatusDot"
                            Width="7"
                            Height="7"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            Margin="8,1,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTip="Status: Idle" />
                </StackPanel>

                <StackPanel x:Name="ExpandedCoreTabsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CoreTabButton}"
                            ToolTip="TrustTunnel core">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="6"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="T"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="AppTitleText"
                                       Text="TrustTunnel"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center" />
                            <Path Data="M6,6 L14,14 M14,6 L6,14"
                                  Stroke="{DynamicResource MutedTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CoreAddButton"
                            Style="{StaticResource CoreAddButton}"
                            ToolTip="Add core"
                            Click="CoreAddButton_Click">
                        <Path Data="M12,5 V19 M5,12 H19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform" />
                    </Button>

                </StackPanel>

                <StackPanel x:Name="CompactCoreSelectorPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CompactCoreSelectorButton"
                            Style="{StaticResource CompactCoreSelectorButton}"
                            ToolTip="Open cores"
                            Click="CoreAddButton_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="7"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="T"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="8"
                                    Padding="6,1"
                                    Margin="6,0,5,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="1"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Path Data="M4,7 L8,11 L12,7"
                                  Stroke="{DynamicResource MutedTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10"
                                  Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CompactCoreAddButton"
                            Style="{StaticResource CoreAddButton}"
                            ToolTip="Add core"
                            Visibility="Collapsed"
                            Click="CoreAddButton_Click">
                        <Path Data="M12,5 V19 M5,12 H19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Popup x:Name="CorePickerPopup"
                       PlacementTarget="{Binding ElementName=CoreAddButton}"
                       Placement="Bottom"
                       HorizontalOffset="-14"
                       VerticalOffset="4"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Closed="CorePickerPopup_Closed">
                    <Grid Margin="14">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="8"
                            Width="272">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26"
                                              ShadowDepth="8"
                                              Direction="270"
                                              Opacity="0.18"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{local:Loc Main.OpenCores}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="8,4,8,8" />
                            <ScrollViewer MaxHeight="292"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                            <Button Style="{StaticResource CoreMenuItemButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="TrustTunnel" FontWeight="Bold" />
                                        <TextBlock Text="{local:Loc Main.ActiveCore}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{local:Loc Main.Open}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CoreMenuItemButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="#C97425">
                                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="sing-box" FontWeight="Bold" />
                                        <TextBlock Text="{local:Loc Main.TrustedRelease}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{local:Loc Main.Soon}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CoreMenuItemButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="#2563EB">
                                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="NaiveProxy" FontWeight="Bold" />
                                        <TextBlock Text="{local:Loc Main.TrustedRelease}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{local:Loc Main.Soon}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CoreMenuItemButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="#7C3AED">
                                        <TextBlock Text="X" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="Xray-core" FontWeight="Bold" />
                                        <TextBlock Text="{local:Loc Main.TrustedRelease}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{local:Loc Main.Soon}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CoreMenuItemButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="#C6445A">
                                        <TextBlock Text="H" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="Hysteria2" FontWeight="Bold" />
                                        <TextBlock Text="{local:Loc Main.TrustedRelease}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{local:Loc Main.Soon}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Popup>

                <StackPanel x:Name="NavButtonsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Width="0"
                            Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CollapseButton"
                            Style="{StaticResource ChromeButton}"
                            ToolTip="{local:Loc Settings.Compact}"
                            Click="CollapseButton_Click">
                        <Path x:Name="ExpandCollapsePath"
                              Data="M5,9 H15 V19 H5 Z M9,5 H19 V15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="CollapseArrowRotation" Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>

                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource ChromeButton}"
                            ToolTip="Hide window"
                            Click="MinimizeButton_Click">
                        <Path Data="M5,12 L19,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform" />
                    </Button>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource ChromeCloseButton}"
                            ToolTip="Close"
                            Click="CloseButton_Click">
                        <Path Data="M6,6 L18,18 M18,6 L6,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="316" />
                    <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,16,18,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Loc Main.Servers}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    CornerRadius="10"
                                    Background="{DynamicResource SubtleSurfaceBrush}"
                                    Padding="8,2"
                                    MinWidth="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileCountText"
                                           Text="0"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <ListBox x:Name="ProfilesList"
                                 Grid.Row="1"
                                 Margin="12,0,12,0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="ProfilesList_SelectionChanged"
                                 PreviewMouseRightButtonDown="ProfilesList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="ProfilesContextMenu_Opened">
                                    <MenuItem x:Name="ContextEditServerMenuItem" Header="{local:Loc Main.ServerParameters}" Click="ContextEditServer_Click" />
                                    <MenuItem x:Name="ContextPingServerMenuItem" Header="{local:Loc Settings.Diagnostics}" Click="ContextPingServer_Click" />
                                    <MenuItem x:Name="ContextDuplicateServerMenuItem" Header="{local:Loc Common.Duplicate}" Click="ContextDuplicateServer_Click" />
