<Window x:Class="TrustTunnel.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки приложения" Width="620" Height="560" MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Настройки приложения" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Внешний вид, диагностика и параметры локальных прокси." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Вид">
                    <Grid Margin="4,14,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Тема" />
                        <ComboBox x:Name="ThemeComboBox" Grid.Row="1">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>

                        <UniformGrid Grid.Row="2" Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Акцент" />
                                <ComboBox x:Name="AccentComboBox">
                                    <ComboBoxItem Content="Forest" />
                                    <ComboBoxItem Content="Ocean" />
                                    <ComboBoxItem Content="Violet" />
                                    <ComboBoxItem Content="Graphite" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Плотность" />
                                <ComboBox x:Name="DensityComboBox">
                                    <ComboBoxItem Content="Comfortable" />
                                    <ComboBoxItem Content="Compact" />
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Диагностика">
                    <StackPanel Margin="4,14,4,4">
                        <TextBlock Text="Ping host" />
                        <TextBox x:Name="PingHostTextBox" />
                        <TextBlock Text="HTTPS test URL" />
                        <TextBox x:Name="HttpsUrlTextBox" />
                        <TextBlock Text="Timeout, seconds" />
                        <TextBox x:Name="TimeoutTextBox" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Прокси">
                    <StackPanel Margin="4,14,4,4">
                        <TextBlock Text="SOCKS5 address по умолчанию" />
                        <TextBox x:Name="SocksAddressTextBox" />
                        <CheckBox x:Name="SocksLanCheckBox" Content="По умолчанию разрешать доступ к SOCKS5 из локальной сети" />
                        <CheckBox x:Name="HttpProxyOptionsCheckBox" Content="Показывать HTTP proxy options" />
                        <TextBlock Text="HTTP proxy address по умолчанию" />
                        <TextBox x:Name="HttpProxyAddressTextBox" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" MinWidth="110" />
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
