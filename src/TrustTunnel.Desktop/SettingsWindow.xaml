<Window x:Class="TrustTunnel.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc Settings.Title}"
        Width="760"
        Height="600"
        MinWidth="760"
        MinHeight="600"
        MaxWidth="760"
        MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SettingsNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Padding="12,10">
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Margin" Value="2,0,0,9" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="SettingsPanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="4"
                                      Opacity="0.12"
                                      Color="{DynamicResource ElevationColor}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="18,15" />
        </Style>

        <Style x:Key="FieldDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="9"
                                                          ShadowDepth="1"
                                                          Opacity="0.16"
                                                          Color="{DynamicResource ElevationColor}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Outer"
                                CornerRadius="999"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Padding="2">
                            <Border CornerRadius="999"
                                    Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track"
                                Width="44"
                                Height="26"
                                CornerRadius="999"
                                Background="{DynamicResource BorderBrush}"
                                Padding="3">
                            <Ellipse x:Name="Knob"
                                     Width="20"
                                     Height="20"
                                     Fill="White"
                                     HorizontalAlignment="Left">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      ShadowDepth="1"
                                                      Opacity="0.28"
                                                      Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SettingsTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <StackPanel>
                    <RadioButton x:Name="AppearanceNavButton"
                                 GroupName="SettingsPages"
                                 Style="{StaticResource SettingsNavButton}"
                                 IsChecked="True"
                                 Tag="Appearance"
                                 Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" Data="M12 3a9 9 0 100 18 9 9 0 000-18zM12 3v18M3 12h18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{local:Loc Settings.Appearance}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="SettingsPages"
                                 Style="{StaticResource SettingsNavButton}"
                                 Tag="Proxy"
                                 Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" Data="M4 7h10M4 12h16M4 17h7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="{local:Loc Settings.Proxy}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="SettingsPages"
                                 Style="{StaticResource SettingsNavButton}"
                                 Tag="Diagnostics"
                                 Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" Data="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{local:Loc Settings.Diagnostics}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="SettingsPages"
                                 Style="{StaticResource SettingsNavButton}"
                                 Tag="About"
                                 Checked="SettingsNav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0" Data="M12 8h.01M11 12h1v4h1M12 3a9 9 0 100 18 9 9 0 000-18z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{local:Loc Settings.About}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="30,26,30,30">
                <Grid>
                    <StackPanel x:Name="AppearancePage">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{local:Loc Settings.Appearance}" />

                        <TextBlock Style="{StaticResource SectionEyebrow}" Text="{local:Loc Settings.Theme}" />
                        <Border Style="{StaticResource SettingsPanelCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.Language}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.LanguageHint}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageComboBox"
                                              Grid.Column="1"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Language"
                                              Margin="0"
                                              MinHeight="36" />
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.ColorScheme}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.ColorSchemeHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeMode" Style="{StaticResource SegmentRadio}" Content="{local:Loc Settings.Light}" />
                                            <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeMode" Style="{StaticResource SegmentRadio}" Content="{local:Loc Settings.Dark}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.AccentColor}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.AccentColorHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="AccentForestRadio" GroupName="AccentColor" Style="{StaticResource AccentSwatchRadio}" Background="#1F7A4D" ToolTip="Forest" />
                                        <RadioButton x:Name="AccentOceanRadio" GroupName="AccentColor" Style="{StaticResource AccentSwatchRadio}" Background="#2563EB" ToolTip="Ocean" />
                                        <RadioButton x:Name="AccentVioletRadio" GroupName="AccentColor" Style="{StaticResource AccentSwatchRadio}" Background="#6D28D9" ToolTip="Violet" />
                                        <RadioButton x:Name="AccentGraphiteRadio" GroupName="AccentColor" Style="{StaticResource AccentSwatchRadio}" Background="#364153" ToolTip="Graphite" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.Density}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.DensityHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="DensityComfortableRadio" GroupName="DensityMode" Style="{StaticResource SegmentRadio}" Content="{local:Loc Settings.Comfortable}" />
                                            <RadioButton x:Name="DensityCompactRadio" GroupName="DensityMode" Style="{StaticResource SegmentRadio}" Content="{local:Loc Settings.Compact}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionEyebrow}" Text="{local:Loc Settings.Window}" />
                        <Border Style="{StaticResource SettingsPanelCard}">
                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.StartMode}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.StartModeHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeExpandedRadio" GroupName="WindowMode" Style="{StaticResource SegmentRadio}" Content="{local:Loc Settings.Expanded}" />
                                        <RadioButton x:Name="ModeCompactRadio" GroupName="WindowMode" Style="{StaticResource SegmentRadio}" Content="{local:Loc Settings.Compact}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProxyPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{local:Loc Settings.Proxy}" />

                        <TextBlock Style="{StaticResource SectionEyebrow}" Text="{local:Loc Settings.Windows}" />
                        <Border Style="{StaticResource SettingsPanelCard}">
                            <Grid Style="{StaticResource FieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.SystemProxy}" />
                                    <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.SystemProxyHint}" />
                                </StackPanel>
                                <CheckBox x:Name="SystemProxyCheckBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionEyebrow}" Text="{local:Loc Settings.SocksListener}" />
                        <Border Style="{StaticResource SettingsPanelCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.LanAccess}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.LanAccessHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="SocksLanCheckBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" />
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.SocksAddress}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.SocksAddressHint}" />
                                    </StackPanel>
                                    <TextBox x:Name="SocksAddressTextBox" Grid.Column="1" FontFamily="Consolas" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{local:Loc Settings.Diagnostics}" />

                        <TextBlock Style="{StaticResource SectionEyebrow}" Text="{local:Loc Settings.ConnectionTests}" />
                        <Border Style="{StaticResource SettingsPanelCard}">
                            <StackPanel>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.PingHost}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.PingHostHint}" />
                                    </StackPanel>
                                    <TextBox x:Name="PingHostTextBox" Grid.Column="1" FontFamily="Consolas" />
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.HttpsUrl}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.HttpsUrlHint}" />
                                    </StackPanel>
                                    <TextBox x:Name="HttpsUrlTextBox" Grid.Column="1" FontFamily="Consolas" />
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.DiagnosticsTimeout}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.DiagnosticsTimeoutHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource StepperButton}" Content="-" Click="TimeoutMinusButton_Click" />
                                            <TextBlock x:Name="TimeoutValueText"
                                                       Width="54"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                            <Button Style="{StaticResource StepperButton}" Content="+" Click="TimeoutPlusButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{local:Loc Settings.About}" />

                        <TextBlock Style="{StaticResource SectionEyebrow}" Text="PROXY OPEN HUB" />
                        <Border Style="{StaticResource SettingsPanelCard}">
                            <StackPanel>
                                <Grid Margin="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/proxy-open-hub-64.png"
                                           Width="52"
                                           Height="52"
                                           Stretch="Uniform"
                                           Margin="0,0,16,0"
                                           SnapsToDevicePixels="True" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Proxy Open Hub" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{local:Loc Settings.Version}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="{local:Loc Settings.Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource FieldDivider}" />
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{local:Loc Settings.Updates}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{local:Loc Settings.UpdatesHint}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{local:Loc Settings.Check}" IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Button Content="{local:Loc Common.Reset}"
                        Style="{StaticResource SettingsTextButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="ResetButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{local:Loc Common.Cancel}"
                            IsCancel="True"
                            Style="{StaticResource GhostButton}"
                            MinWidth="92" />
                    <Button Content="{local:Loc Common.Save}"
                            Click="SaveButton_Click"
                            MinWidth="110"
                            Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
