<Window x:Class="TrustTunnel.Desktop.TomlImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc ImportToml.Title}"
        Width="620"
        Height="520"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{local:Loc ImportToml.Title}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{local:Loc ImportToml.Subtitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource DialogFlatCard}"
                    Padding="8">
                <TextBox x:Name="TomlTextBox"
                         Style="{StaticResource DialogEditorTextBox}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{local:Loc ImportToml.Import}"
                            Click="ImportButton_Click" />
                    <Button Content="{local:Loc Common.Cancel}"
                            IsCancel="True"
                            Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
