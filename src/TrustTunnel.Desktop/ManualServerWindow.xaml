<Window x:Class="TrustTunnel.Desktop.ManualServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc Manual.Title}"
        Width="560"
        Height="500"
        MinWidth="560"
        MinHeight="500"
        MaxWidth="560"
        MaxHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{local:Loc Manual.Title}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{local:Loc Manual.Subtitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,0" MinHeight="52">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Name}" />
                                <TextBox x:Name="NameTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.HostnameSni}" />
                                <TextBox x:Name="HostnameTextBox" Text="vpn.example.com" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0" MinHeight="52">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Manual.Address}" />
                                <TextBox x:Name="AddressTextBox" Text="vpn.example.com:443" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Username}" />
                                <TextBox x:Name="UsernameTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0" MinHeight="52">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Password}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource CompactPasswordField}"
                                                 Margin="0,3,4,8" />
                                    <TextBox x:Name="PasswordRevealTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource CompactField}"
                                             Margin="0,3,4,8"
                                             Visibility="Collapsed" />
                                    <Button Grid.Column="1"
                                            Click="PasswordRevealButton_Click"
                                            Style="{StaticResource SecretRevealButton}"
                                            ToolTip="{local:Loc Common.ShowPassword}" />
                                </Grid>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Manual.QuickOptions}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <WrapPanel>
                                <CheckBox x:Name="Http3CheckBox" Content="HTTP/3 / QUIC" />
                                <CheckBox x:Name="CustomDnsCheckBox" Content="Cloudflare DoT" IsChecked="True" />
                                <CheckBox x:Name="KillSwitchCheckBox" Content="Kill switch" IsChecked="True" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,14,0,0"
                    Padding="0,14,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="ResultText"
                               DockPanel.Dock="Left"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{local:Loc Common.Save}"
                                Click="SaveButton_Click"
                                ToolTip="{local:Loc Manual.SaveTooltip}"
                                MinWidth="110" />
                        <Button Content="{local:Loc Common.Cancel}"
                                IsCancel="True"
                                Style="{StaticResource GhostButton}"
                                ToolTip="{local:Loc Profile.CancelTooltip}"
                                MinWidth="100" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
