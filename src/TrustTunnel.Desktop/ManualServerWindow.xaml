<Window x:Class="TrustTunnel.Desktop.ManualServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить вручную" Width="560" Height="560" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Добавить сервер" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Основные поля профиля. Расширенные параметры можно поменять после добавления."
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="12" UseLayoutRounding="True">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0" MinHeight="52">
                            <TextBlock Text="Название" />
                            <TextBox x:Name="NameTextBox" Style="{StaticResource CompactField}" />
                        </StackPanel>
                        <StackPanel MinHeight="52">
                            <TextBlock Text="Hostname/SNI" />
                            <TextBox x:Name="HostnameTextBox" Text="vpn.example.com" Style="{StaticResource CompactField}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" MinHeight="52">
                            <TextBlock Text="Адрес host:port" />
                            <TextBox x:Name="AddressTextBox" Text="vpn.example.com:443" Style="{StaticResource CompactField}" />
                        </StackPanel>
                        <StackPanel MinHeight="52">
                            <TextBlock Text="Логин" />
                            <TextBox x:Name="UsernameTextBox" Style="{StaticResource CompactField}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" MinHeight="52">
                            <TextBlock Text="Пароль" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordBox" Grid.Column="0" Style="{StaticResource CompactPasswordField}" Margin="0,3,4,8" />
                                <TextBox x:Name="PasswordRevealTextBox" Grid.Column="0" Style="{StaticResource CompactField}" Margin="0,3,4,8" Visibility="Collapsed" />
                                <Button Grid.Column="1" Click="PasswordRevealButton_Click" Style="{StaticResource SecretRevealButton}" ToolTip="Показать пароль" />
                            </Grid>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" UseLayoutRounding="True">
                    <WrapPanel>
                        <CheckBox x:Name="Http3CheckBox" Content="HTTP/3 / QUIC" />
                        <CheckBox x:Name="CustomDnsCheckBox" Content="Cloudflare DoT" IsChecked="True" />
                        <CheckBox x:Name="KillSwitchCheckBox" Content="Kill switch" IsChecked="True" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ResultText" DockPanel.Dock="Left" Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Сохранить" Click="SaveButton_Click" ToolTip="Сохранить сервер" MinWidth="110" />
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource GhostButton}" ToolTip="Закрыть без сохранения" MinWidth="100" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
