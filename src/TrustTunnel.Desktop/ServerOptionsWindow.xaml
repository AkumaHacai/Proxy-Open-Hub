<Window x:Class="TrustTunnel.Desktop.ServerOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры профиля" Width="740" Height="660" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Параметры профиля" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText"
                       Text="Подключение, маршруты, безопасность и расширенные параметры."
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Header="Подключение" IsExpanded="True" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,6,0,0">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Название" />
                                <TextBox x:Name="NameTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0" MinHeight="52">
                                <TextBlock Text="Hostname/SNI" />
                                <TextBox x:Name="HostnameTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Custom SNI" />
                                <TextBox x:Name="CustomSniTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Text="Адреса, по одному в строке" />
                                <TextBox x:Name="AddressesTextBox" Style="{StaticResource CompactField}" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Логин" />
                                <TextBox x:Name="UsernameTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Text="Новый пароль" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordBox" Grid.Column="0" Style="{StaticResource CompactPasswordField}" Margin="0,3,4,8" />
                                    <TextBox x:Name="PasswordRevealTextBox" Grid.Column="0" Style="{StaticResource CompactField}" Margin="0,3,4,8" Visibility="Collapsed" />
                                    <Button Grid.Column="1" Click="PasswordRevealButton_Click" Style="{StaticResource SecretRevealButton}" ToolTip="Показать пароль" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Транспорт" />
                                <ComboBox x:Name="ProtocolComboBox" Height="34" MinHeight="34" Margin="0,3,8,8">
                                    <ComboBoxItem Content="HTTP/2" />
                                    <ComboBoxItem Content="HTTP/3 / QUIC" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Text="Режим" />
                                <ComboBox x:Name="ListenerComboBox" Height="34" MinHeight="34" Margin="0,3,8,8">
                                    <ComboBoxItem Content="TUN system VPN" />
                                    <ComboBoxItem Content="SOCKS5 proxy" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Fallback" />
                                <ComboBox x:Name="FallbackComboBox" Height="34" MinHeight="34" Margin="0,3,8,8">
                                    <ComboBoxItem Content="Нет" />
                                    <ComboBoxItem Content="HTTP/2" />
                                    <ComboBoxItem Content="HTTP/3" />
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Expander>

                <Expander Header="Переключатели" IsExpanded="True" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,6,0,0">
                        <WrapPanel>
                            <CheckBox x:Name="HasIpv6CheckBox" Content="IPv6" />
                            <CheckBox x:Name="PostQuantumCheckBox" Content="Post-quantum group" />
                            <CheckBox x:Name="AntiDpiCheckBox" Content="Anti-DPI" />
                            <CheckBox x:Name="SkipVerificationCheckBox" Content="Skip certificate verification" />
                            <CheckBox x:Name="KillSwitchCheckBox" Content="Kill switch" />
                            <CheckBox x:Name="ChangeSystemDnsCheckBox" Content="Менять системный DNS" />
                            <CheckBox x:Name="UseExistingTunCheckBox" Content="Use existing TUN" />
                            <CheckBox x:Name="ServiceModeCheckBox" Content="Windows Service mode" />
                            <CheckBox x:Name="AutoConnectCheckBox" Content="Auto-connect" />
                        </WrapPanel>
                    </Border>
                </Expander>

                <Expander Header="Routing / DNS" IsExpanded="False" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,6,0,0">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Routing profile" />
                                <ComboBox x:Name="RoutingProfileComboBox" Height="34" MinHeight="34" Margin="0,3,8,8" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Text="Routing mode" />
                                <ComboBox x:Name="RoutingModeComboBox" Height="34" MinHeight="34" Margin="0,3,8,8">
                                    <ComboBoxItem Content="General" />
                                    <ComboBoxItem Content="Selective" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="78">
                                <TextBlock Text="DNS upstreams" />
                                <TextBox x:Name="DnsTextBox" Height="58" MinHeight="58" Padding="10,6" Margin="0,3,8,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel MinHeight="78">
                                <TextBlock Text="Exclusions" />
                                <TextBox x:Name="ExclusionsTextBox" Height="58" MinHeight="58" Padding="10,6" Margin="0,3,8,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="78">
                                <TextBlock Text="Included routes" />
                                <TextBox x:Name="IncludedRoutesTextBox" Height="58" MinHeight="58" Padding="10,6" Margin="0,3,8,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel MinHeight="78">
                                <TextBlock Text="Excluded routes" />
                                <TextBox x:Name="ExcludedRoutesTextBox" Height="58" MinHeight="58" Padding="10,6" Margin="0,3,8,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="Kill switch allow ports" />
                                <TextBox x:Name="KillSwitchPortsTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Text="MTU" />
                                <TextBox x:Name="MtuTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" MinHeight="52">
                                <TextBlock Text="TCP recv buffer" />
                                <TextBox x:Name="RecvBufferTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                            <StackPanel MinHeight="52">
                                <TextBlock Text="TCP send buffer" />
                                <TextBox x:Name="SendBufferTextBox" Style="{StaticResource CompactField}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Expander>

                <Expander Header="Advanced" IsExpanded="False">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0" MinHeight="52">
                                    <TextBlock Text="TUN bound_if" />
                                    <TextBox x:Name="BoundIfTextBox" Style="{StaticResource CompactField}" />
                                </StackPanel>
                                <StackPanel MinHeight="52">
                                    <TextBlock Text="TUN device name" />
                                    <TextBox x:Name="DeviceNameTextBox" Style="{StaticResource CompactField}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0" MinHeight="52">
                                    <TextBlock Text="Client random" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ClientRandomBox" Grid.Column="0" Style="{StaticResource CompactPasswordField}" Margin="0,3,4,8" />
                                        <TextBox x:Name="ClientRandomRevealTextBox" Grid.Column="0" Style="{StaticResource CompactField}" Margin="0,3,4,8" Visibility="Collapsed" />
                                        <Button Grid.Column="1" Click="ClientRandomRevealButton_Click" Style="{StaticResource SecretRevealButton}" ToolTip="Показать client random" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel MinHeight="52">
                                    <TextBlock Text="SOCKS5 address" />
                                    <TextBox x:Name="SocksAddressTextBox" Style="{StaticResource CompactField}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0" MinHeight="52">
                                    <TextBlock Text="SOCKS5 username" />
                                    <TextBox x:Name="SocksUsernameTextBox" Style="{StaticResource CompactField}" />
                                </StackPanel>
                                <StackPanel MinHeight="52">
                                    <TextBlock Text="SOCKS5 password" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="SocksPasswordBox" Grid.Column="0" Style="{StaticResource CompactPasswordField}" Margin="0,3,4,8" />
                                        <TextBox x:Name="SocksPasswordRevealTextBox" Grid.Column="0" Style="{StaticResource CompactField}" Margin="0,3,4,8" Visibility="Collapsed" />
                                        <Button Grid.Column="1" Click="SocksPasswordRevealButton_Click" Style="{StaticResource SecretRevealButton}" ToolTip="Показать SOCKS5 password" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0" MinHeight="52">
                                    <TextBlock Text="HTTP proxy address" />
                                    <TextBox x:Name="HttpProxyAddressTextBox" Style="{StaticResource CompactField}" />
                                </StackPanel>
                                <StackPanel MinHeight="52">
                                    <CheckBox x:Name="SocksAllowLanCheckBox" Content="SOCKS5 доступен в локальной сети" />
                                    <CheckBox x:Name="HttpProxyAllowLanCheckBox" Content="HTTP proxy доступен в локальной сети" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Certificate PEM" />
                            <TextBox x:Name="CertificatePemTextBox" MinHeight="120" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" MinWidth="110" />
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
