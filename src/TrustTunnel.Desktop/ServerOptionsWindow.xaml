<Window x:Class="TrustTunnel.Desktop.ServerOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc Profile.WindowTitle}"
        Width="720"
        Height="620"
        MinWidth="720"
        MinHeight="620"
        MaxWidth="720"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionNavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="SectionNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Padding="12,8">
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="{local:Loc Profile.Subtitle}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,6"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="ProfileBadgeText"
                               Text="{local:Loc Profile.Badge}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Padding="6"
                        Margin="0,0,0,12">
                    <WrapPanel>
                        <RadioButton x:Name="ConnectionNavButton"
                                     Style="{StaticResource SectionNavButton}"
                                     GroupName="ProfileSections"
                                     Content="{local:Loc Profile.Connection}"
                                     Tag="Connection"
                                     IsChecked="True"
                                     Checked="SectionNav_Checked" />
                        <RadioButton x:Name="SwitchesNavButton"
                                     Style="{StaticResource SectionNavButton}"
                                     GroupName="ProfileSections"
                                     Content="{local:Loc Profile.Switches}"
                                     Tag="Switches"
                                     Checked="SectionNav_Checked" />
                        <RadioButton x:Name="RoutingNavButton"
                                     Style="{StaticResource SectionNavButton}"
                                     GroupName="ProfileSections"
                                     Content="{local:Loc Profile.RoutingDns}"
                                     Tag="Routing"
                                     Checked="SectionNav_Checked" />
                        <RadioButton x:Name="LocalNavButton"
                                     Style="{StaticResource SectionNavButton}"
                                     GroupName="ProfileSections"
                                     Content="{local:Loc Profile.Local}"
                                     Tag="Local"
                                     Checked="SectionNav_Checked" />
                        <RadioButton x:Name="AdvancedNavButton"
                                     Style="{StaticResource SectionNavButton}"
                                     GroupName="ProfileSections"
                                     Content="{local:Loc Profile.Advanced}"
                                     Tag="Advanced"
                                     Checked="SectionNav_Checked" />
                    </WrapPanel>
                </Border>

                <ScrollViewer x:Name="OptionsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <Border x:Name="ConnectionSection"
                                Style="{StaticResource Card}"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Profile.Connection}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Name}" />
                                        <TextBox x:Name="NameTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.HostnameSni}" />
                                        <TextBox x:Name="HostnameTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.CustomSni}" />
                                        <TextBox x:Name="CustomSniTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Addresses}" />
                                        <TextBox x:Name="AddressesTextBox"
                                                 Style="{StaticResource CompactField}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Username}" />
                                        <TextBox x:Name="UsernameTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Password}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="PasswordBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource CompactPasswordField}"
                                                         Margin="0,3,4,8" />
                                            <TextBox x:Name="PasswordRevealTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource CompactField}"
                                                     Margin="0,3,4,8"
                                                     Visibility="Collapsed" />
                                            <Button Grid.Column="1"
                                                    Click="PasswordRevealButton_Click"
                                                    Style="{StaticResource SecretRevealButton}"
                                                    ToolTip="{local:Loc Common.ShowPassword}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Transport}" />
                                        <ComboBox x:Name="ProtocolComboBox"
                                                  Height="34"
                                                  MinHeight="34"
                                                  Margin="0,3,8,8">
                                            <ComboBoxItem Content="HTTP/2" />
                                            <ComboBoxItem Content="HTTP/3 / QUIC" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.ClientMode}" />
                                        <ComboBox x:Name="ListenerComboBox"
                                                  Height="34"
                                                  MinHeight="34"
                                                  Margin="0,3,8,8">
                                            <ComboBoxItem Content="{local:Loc Profile.TunMode}" />
                                            <ComboBoxItem Content="{local:Loc Profile.SocksMode}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.FallbackProtocol}" />
                                        <ComboBox x:Name="FallbackComboBox"
                                                  Height="34"
                                                  MinHeight="34"
                                                  Margin="0,3,8,8">
                                            <ComboBoxItem Content="{local:Loc Common.None}" />
                                            <ComboBoxItem Content="HTTP/2" />
                                            <ComboBoxItem Content="HTTP/3" />
                                        </ComboBox>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SwitchesSection"
                                Style="{StaticResource Card}"
                                Padding="14"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Profile.Switches}" />
                                <WrapPanel>
                                    <CheckBox x:Name="HasIpv6CheckBox" Content="IPv6" />
                                    <CheckBox x:Name="PostQuantumCheckBox" Content="{local:Loc Profile.PostQuantum}" />
                                    <CheckBox x:Name="AntiDpiCheckBox" Content="{local:Loc Profile.AntiDpi}" />
                                    <CheckBox x:Name="SkipVerificationCheckBox" Content="{local:Loc Profile.SkipVerification}" />
                                    <CheckBox x:Name="KillSwitchCheckBox" Content="{local:Loc Profile.KillSwitch}" />
                                    <CheckBox x:Name="ChangeSystemDnsCheckBox" Content="{local:Loc Profile.ChangeSystemDns}" />
                                    <CheckBox x:Name="UseExistingTunCheckBox" Content="{local:Loc Profile.UseExistingTun}" />
                                    <CheckBox x:Name="ServiceModeCheckBox" Content="{local:Loc Profile.ServiceMode}" />
                                    <CheckBox x:Name="AutoConnectCheckBox" Content="{local:Loc Profile.AutoConnect}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RoutingSection"
                                Style="{StaticResource Card}"
                                Padding="14"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Profile.RoutingDns}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.RoutingProfile}" />
                                        <ComboBox x:Name="RoutingProfileComboBox"
                                                  Height="34"
                                                  MinHeight="34"
                                                  Margin="0,3,8,8" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.RoutingMode}" />
                                        <ComboBox x:Name="RoutingModeComboBox"
                                                  Height="34"
                                                  MinHeight="34"
                                                  Margin="0,3,8,8">
                                            <ComboBoxItem Content="{local:Loc Profile.RoutingGeneral}" />
                                            <ComboBoxItem Content="{local:Loc Profile.RoutingSelective}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="78">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.DnsUpstreams}" />
                                        <TextBox x:Name="DnsTextBox"
                                                 Height="58"
                                                 Padding="10,6"
                                                 Margin="0,3,8,8"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel MinHeight="78">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Exclusions}" />
                                        <TextBox x:Name="ExclusionsTextBox"
                                                 Height="58"
                                                 Padding="10,6"
                                                 Margin="0,3,8,8"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="78">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.IncludedRoutes}" />
                                        <TextBox x:Name="IncludedRoutesTextBox"
                                                 Height="58"
                                                 Padding="10,6"
                                                 Margin="0,3,8,8"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel MinHeight="78">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.ExcludedRoutes}" />
                                        <TextBox x:Name="ExcludedRoutesTextBox"
                                                 Height="58"
                                                 Padding="10,6"
                                                 Margin="0,3,8,8"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.KillSwitchPorts}" />
                                        <TextBox x:Name="KillSwitchPortsTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.Mtu}" />
                                        <TextBox x:Name="MtuTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.TcpRecv}" />
                                        <TextBox x:Name="RecvBufferTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.TcpSend}" />
                                        <TextBox x:Name="SendBufferTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LocalSection"
                                Style="{StaticResource Card}"
                                Padding="14"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Profile.Local}" />
                                <TextBlock Text="{local:Loc Profile.LocalHint}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.TunBoundIf}" />
                                        <TextBox x:Name="BoundIfTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.TunDeviceName}" />
                                        <TextBox x:Name="DeviceNameTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0" MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.SocksUsername}" />
                                        <TextBox x:Name="SocksUsernameTextBox" Style="{StaticResource CompactField}" />
                                    </StackPanel>
                                    <StackPanel MinHeight="52">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.SocksPassword}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="SocksPasswordBox"
                                                         Grid.Column="0"
                                                         Style="{StaticResource CompactPasswordField}"
                                                         Margin="0,3,4,8" />
                                            <TextBox x:Name="SocksPasswordRevealTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource CompactField}"
                                                     Margin="0,3,4,8"
                                                     Visibility="Collapsed" />
                                            <Button Grid.Column="1"
                                                    Click="SocksPasswordRevealButton_Click"
                                                    Style="{StaticResource SecretRevealButton}"
                                                    ToolTip="{local:Loc Common.ShowSocksPassword}" />
                                        </Grid>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AdvancedSection"
                                Style="{StaticResource Card}"
                                Padding="14"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Profile.Advanced}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.ClientRandom}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ClientRandomBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource CompactPasswordField}"
                                                 Margin="0,3,4,8" />
                                    <TextBox x:Name="ClientRandomRevealTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource CompactField}"
                                             Margin="0,3,4,8"
                                             Visibility="Collapsed" />
                                    <Button Grid.Column="1"
                                            Click="ClientRandomRevealButton_Click"
                                            Style="{StaticResource SecretRevealButton}"
                                            ToolTip="{local:Loc Common.ShowClientRandom}" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Profile.CertificatePem}" />
                                <TextBox x:Name="CertificatePemTextBox"
                                         MinHeight="120"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,14,0,0"
                    Padding="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{local:Loc Common.Save}"
                            Click="SaveButton_Click"
                            MinWidth="112"
                            ToolTip="{local:Loc Profile.SaveTooltip}" />
                    <Button Content="{local:Loc Common.Cancel}"
                            IsCancel="True"
                            Style="{StaticResource GhostButton}"
                            MinWidth="100"
                            ToolTip="{local:Loc Profile.CancelTooltip}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
