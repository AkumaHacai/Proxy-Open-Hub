<Window x:Class="TrustTunnel.Desktop.RoutingProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Routing profiles" Width="680" Height="520" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Routing profiles" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Профили маршрутизации можно применять к серверам из главного окна." Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name" />
                    <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button Content="+" Click="AddButton_Click" Width="44" Height="34" MinWidth="44" Padding="0" ToolTip="Создать профиль" />
                        <Button Content="Удалить" Click="DeleteButton_Click" Style="{StaticResource DangerButton}" MinWidth="88" Height="34" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Название" />
                        <TextBox x:Name="NameTextBox" Style="{StaticResource CompactField}" />
                        <TextBlock Text="Описание" />
                        <TextBox x:Name="DescriptionTextBox" Style="{StaticResource CompactField}" />
                        <TextBlock Text="Mode" />
                        <ComboBox x:Name="ModeComboBox" Height="34" MinHeight="34" Margin="0,3,8,8">
                            <ComboBoxItem Content="General" />
                            <ComboBoxItem Content="Selective" />
                        </ComboBox>
                        <CheckBox x:Name="KillSwitchCheckBox" Content="Kill switch" />
                        <TextBlock Text="Exclusions / domains / CIDR" />
                        <TextBox x:Name="ExclusionsTextBox" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Allow ports" />
                        <TextBox x:Name="PortsTextBox" Style="{StaticResource CompactField}" />
                        <Button Content="Сохранить профиль" Click="SaveProfileButton_Click" MinWidth="160" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="Local bypass preset" Click="LocalBypassButton_Click" Style="{StaticResource GhostButton}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Применить" Click="DoneButton_Click" MinWidth="110" />
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource GhostButton}" MinWidth="100" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
