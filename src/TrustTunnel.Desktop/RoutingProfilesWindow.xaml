<Window x:Class="TrustTunnel.Desktop.RoutingProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrustTunnel.Desktop"
        Title="{local:Loc Routing.Title}"
        Width="680"
        Height="520"
        MinWidth="680"
        MinHeight="520"
        MaxWidth="680"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="TinyActionButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusSm}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyDeleteButton" TargetType="Button" BasedOn="{StaticResource TinyActionButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{local:Loc Routing.Title}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{local:Loc Routing.Subtitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DialogFlatCard}"
                        Padding="14"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{local:Loc Routing.Profiles}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Click="AddButton_Click"
                                        Style="{StaticResource TinyActionButton}"
                                        ToolTip="{local:Loc Common.CreateProfile}">
                                    <Grid Width="14" Height="14">
                                        <Line X1="7"
                                              Y1="2"
                                              X2="7"
                                              Y2="12"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Line X1="2"
                                              Y1="7"
                                              X2="12"
                                              Y2="7"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                </Button>
                                <Button Click="DeleteButton_Click"
                                        Style="{StaticResource TinyDeleteButton}"
                                        Margin="6,0,0,0"
                                        ToolTip="{local:Loc Common.DeleteProfile}">
                                    <Grid Width="14" Height="14">
                                        <Line X1="2"
                                              Y1="7"
                                              X2="12"
                                              Y2="7"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="ProfilesList"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="ProfilesList_SelectionChanged"
                                 DisplayMemberPath="Name"
                                 ItemContainerStyle="{StaticResource DialogListBoxItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DialogFlatCard}"
                        Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Routing.Name}" />
                            <TextBox x:Name="NameTextBox" Style="{StaticResource CompactField}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Routing.Description}" />
                            <TextBox x:Name="DescriptionTextBox" Style="{StaticResource CompactField}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Routing.Mode}" />
                            <ComboBox x:Name="ModeComboBox" Height="36" MinHeight="36" Margin="0,3,8,10">
                                <ComboBoxItem Content="{local:Loc Routing.General}" />
                                <ComboBoxItem Content="{local:Loc Routing.Selective}" />
                            </ComboBox>

                            <CheckBox x:Name="KillSwitchCheckBox" Content="Kill switch" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Routing.Presets}" />
                            <WrapPanel Margin="0,3,0,10">
                                <Button Content="{local:Loc Routing.RuBypass}"
                                        Click="RuBypassPresetButton_Click"
                                        Style="{StaticResource GhostButton}"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        ToolTip="{local:Loc Routing.RuBypassTip}" />
                                <Button Content="{local:Loc Routing.LocalBypassShort}"
                                        Click="LocalBypassPresetButton_Click"
                                        Style="{StaticResource GhostButton}"
                                        MinWidth="154"
                                        Margin="0,0,8,8"
                                        ToolTip="{local:Loc Routing.LocalBypassTip}" />
                                <Button Content="{local:Loc Routing.SelectivePreset}"
                                        Click="SelectivePresetButton_Click"
                                        Style="{StaticResource GhostButton}"
                                        MinWidth="168"
                                        Margin="0,0,8,8"
                                        ToolTip="{local:Loc Routing.SelectivePresetTip}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Routing.Rules}" />
                            <TextBlock Text="{local:Loc Routing.RulesHint}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,8,6" />
                            <TextBox x:Name="ExclusionsTextBox"
                                     MinHeight="108"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Loc Routing.KillSwitchPorts}" />
                            <TextBox x:Name="PortsTextBox" Style="{StaticResource CompactField}" />

                            <Button Content="{local:Loc Routing.SaveProfile}"
                                    Click="SaveProfileButton_Click"
                                    Style="{StaticResource GhostButton}"
                                    MinWidth="160"
                                    HorizontalAlignment="Left"
                                    ToolTip="{local:Loc Routing.SaveProfileTip}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Grid>
                <Button Content="{local:Loc Routing.LocalBypass}"
                        Click="LocalBypassButton_Click"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{local:Loc Common.Apply}"
                            Click="DoneButton_Click"
                            MinWidth="110" />
                    <Button Content="{local:Loc Common.Cancel}"
                            IsCancel="True"
                            Style="{StaticResource GhostButton}"
                            MinWidth="100" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
